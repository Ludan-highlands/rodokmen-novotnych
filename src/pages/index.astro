---
import { pathFor } from '../lib/data.js';
import Base from '../layouts/Base.astro';
import { lines, href, config, linesTitle } from '../lib/data.js';
import fan from '../generated/fan.svg?raw';
import PersonLink from '../components/PersonLink.astro';
import { byK } from '../lib/data.js';
import { frontmatter as pribeh } from '../generated/pribeh.md';
const lineList = Object.values(lines).sort((a, b) => a.k - b.k);
const uvod = config.uvod ?? {};
const branch = [1, 2, 5, 10, 20].map((number) => byK[number]).filter(Boolean);
const cards = config.zajimavosti_na_uvodu ?? [];
---
<Base title="" wide>
  <h1>{config.nazev || 'Rodokmen'}</h1>

  {!!(uvod.nadpis || uvod.odstavce?.length) && (
    <section class="teaser single">
      <div>
        {uvod.nadpis && <h2>{uvod.nadpis}</h2>}
        {(uvod.odstavce ?? []).map((t) => <p>{t}</p>)}
        <div class="home-actions">
          <a class="btn" href={pathFor('/vejir/')}>Otevřít rodokmen</a>
          <a class="btn" href={pathFor('/mapa/')}>Domy a mapa</a>
          <a class="btn" href={pathFor('/pribehy/')}>{pribeh.title} →</a>
        </div>
      </div>
      {uvod.foto && (
        <a href={pathFor(config.maPribeh ? '/pribehy/' : `/img/${uvod.foto}.jpg`)}><img src={pathFor(`/img/${uvod.foto}.jpg`)} alt={uvod.foto_popis || ''} /></a>
      )}
    </section>
  )}

  {config.maPribeh && !(uvod.nadpis || uvod.odstavce?.length) && (
    <section class="teaser">
      <div>
        <h2>{pribeh.title}</h2>
        {pribeh.lead && <p>{pribeh.lead}</p>}
        <a class="btn" href={pathFor('/pribehy/')}>{config.pribeh?.tlacitko || 'Přečíst příběh'} →</a>
      </div>
    </section>
  )}

  <h2>Hlavní větev</h2>
  <div class="branch">
    {branch.map((person, index) => <>{index > 0 && <span aria-hidden="true">→</span>}<PersonLink slug={person.slug} /></>)}
  </div>
  <p class="small muted">U Kateřiny a Tomáše karty vysvětlují, které vlastní zápisy dosud zůstávají kandidátní.</p>

  {cards.length > 0 && (
    <>
      <h2>Zajímavosti</h2>
      <div class="grid2">
        {cards.map((c) => (
          <a class="card card-link" href={pathFor('/zajimavosti/')}><h3>{c.nadpis}</h3><p class="small muted">{c.text}</p></a>
        ))}
      </div>
      <p><a href={pathFor('/zajimavosti/')}>Všechny zajímavosti →</a></p>
    </>
  )}

  {lineList.length > 0 && (
    <>
      <h2>{linesTitle(lineList.length)}</h2>
      <div class="grid2">
        {lineList.map((l) => (
          <a class="card line-card card-link" style={`--c:${l.color}`} href={href.line(l.slug)}>
            <h3>{l.name}</h3>
            <p class="small muted">{l.desc}</p>
          </a>
        ))}
      </div>
    </>
  )}

  <h2>Rodokmen</h2>
  <div class="fan-preview"><a class="cover" href={pathFor('/vejir/')} aria-label="Otevřít vějíř předků přes celou obrazovku"></a><Fragment set:html={fan} /></div>
  <p><a class="btn" href={pathFor('/vejir/')}>Otevřít vějíř předků přes celou obrazovku →</a> <a href={pathFor('/predci/')} style="margin-left:1rem">nebo seznam všech předků</a></p>
</Base>
